generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 1. Customers: 客户 (扩展版)
model Customer {
  id           String   @id @default(uuid())
  companyName  String   @map("company_name")
  industry     String?  // 行业
  companySize  String?  @map("company_size") // 规模
  city         String?  // 城市
  country      String?  // 国家
  contactName  String?  @map("contact_name")
  contactTitle String?  @map("contact_title") // 联系人职位
  contactPhone String?  @map("contact_phone")
  contactEmail String?  @map("contact_email")
  createdAt    DateTime @default(now()) @map("created_at")

  opportunities Opportunity[]
  vendors       Vendor[]

  @@map("customers")
}

// 2. Opportunities: 商机 (企业版)
model Opportunity {
  id                String   @id @default(uuid())
  opportunityNumber String?  @unique @map("opportunity_number") // 商机编号 OPP-YYYY-NNNN
  customerId        String   @map("customer_id")
  title             String
  status            OpportunityStatus @default(New)
  estimatedValue    Decimal? @map("estimated_value")
  probability       Int?     @default(0)
  source            String?
  expectedCloseDate DateTime? @map("expected_close_date")
  
  // Phase 5: Enterprise Fields
  salesStage        String?  @map("sales_stage")      // 销售阶段
  competitors       String?                           // 竞争对手
  decisionMakers    String?  @map("decision_makers")  // 决策链/关键人
  salesOwner        String?  @map("sales_owner")      // 销售负责人
  dealType          String?  @map("deal_type")        // 项目类型
  deliveryModel     String?  @map("delivery_model")   // 交付模式
  estimatedEffort   Int?     @map("estimated_effort") // 预计人天
  richDescription   String?  @map("rich_description") // 富文本描述 (HTML)
  
  // Phase 6: Financial Fields 财务字段
  projectBudget     Decimal? @map("project_budget")   // 客户预算
  businessCost      Decimal? @map("business_cost")    // 商务费用
  laborCost         Decimal? @map("labor_cost")       // 人力成本
  otherCost         Decimal? @map("other_cost")       // 其他成本
  grossProfit       Decimal? @map("gross_profit")     // 毛利润
  profitMargin      Decimal? @map("profit_margin")    // 毛利率(%)
  
  // Business Type Classification
  businessType      BusinessType? @map("business_type") // 业务类型
  
  createdAt         DateTime @default(now()) @map("created_at")

  customer     Customer      @relation(fields: [customerId], references: [id])
  contracts    Contract[]
  followUps    FollowUp[]
  attachments  Attachment[]
  procurements Procurement[]
  vendors      Vendor[]

  @@map("opportunities")
}

enum OpportunityStatus {
  New
  Proposal
  Negotiation
  Bidding         // 投标中
  Comparison      // 比价
  SingleSource    // 单一来源
  Sourcing        // 寻源
  Won
  Lost
}

enum BusinessType {
  PROJECT_DEVELOPMENT  // 项目开发
  OUTSOURCING         // 外包人力
  PRODUCT_SALES       // 产品销售
  CONSULTING          // 咨询服务
  OTHER               // 其他
}

// 3. Contracts: 合同
model Contract {
  id                 String   @id @default(uuid())
  contractNumber     String   @unique @map("contract_number") // 合同编号
  opportunityId      String   @map("opportunity_id")
  
  status             ContractStatus @default(Draft)
  totalContractValue Decimal  @map("total_contract_value")
  paymentTerms       String?  @map("payment_terms")       // 付款条款概要
  
  // Pricing Information (from Procurement/Opportunity)
  wonPrice           Decimal? @map("won_price")           // 中标金额
  estimatedValue     Decimal? @map("estimated_value")     // 预估金额
  
  startDate          DateTime? @map("start_date")
  endDate            DateTime? @map("end_date")
  
  // Customer Contact Information (from Customer)
  customerContactName  String? @map("customer_contact_name")
  customerContactPhone String? @map("customer_contact_phone")
  customerContactEmail String? @map("customer_contact_email")
  customerContactTitle String? @map("customer_contact_title")
  
  // Vendor Contact Information
  vendorName         String? @map("vendor_name")
  vendorContactName  String? @map("vendor_contact_name")
  vendorContactPhone String? @map("vendor_contact_phone")
  
  // 风险与审批
  riskAssessment     String?  @map("risk_assessment")     // 风险评估
  
  // IT Project Fields
  scope               String?
  sla                 String?
  liability           String?
  paymentTermsDetails String?  @map("payment_terms_details")
  
  // Payment & Financial Information
  paymentAccount      String?  @map("payment_account")        // 收款账号
  bankName            String?  @map("bank_name")              // 开户银行
  accountName         String?  @map("account_name")           // 账户名称
  
  // Contract Terms
  penalties           String?                                 // 罚则/违约条款
  warranty            String?                                 // 质保条款
  confidentiality     String?                                 // 保密条款
  disputeResolution   String?  @map("dispute_resolution")     // 争议解决方式
  specialTerms        String?  @map("special_terms")          // 特殊条款

  drafterId          String?  @map("drafter_id")          // 拟稿人
  approverId         String?  @map("approver_id")         // 审批人
  
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id])
  drafter     User?       @relation("ContractDrafter", fields: [drafterId], references: [id])
  approver    User?       @relation("ContractApprover", fields: [approverId], references: [id])
  milestones  Milestone[]
  documents   ContractDocument[]
  lineItems   ContractLineItem[]  // 合同分项明细
  project     Project?
  invoices    Invoice[]

  @@map("contracts")
}

// 12a. ContractLineItem: 合同分项明细
model ContractLineItem {
  id              String   @id @default(uuid())
  contractId      String   @map("contract_id")
  
  // 分项信息
  itemName        String   @map("item_name")          // 项目名称
  itemType        LineItemType @map("item_type")      // 产品/服务
  description     String?                             // 详细描述
  
  // 金额信息
  quantity        Decimal  @default(1)                // 数量
  unitPrice       Decimal  @map("unit_price")         // 单价（不含税）
  taxRate         Decimal  @map("tax_rate")           // 税率 (0.13, 0.06, 0)
  
  // 计算字段
  subtotal        Decimal                             // 小计 = quantity * unitPrice
  taxAmount       Decimal  @map("tax_amount")         // 税额 = subtotal * taxRate
  totalAmount     Decimal  @map("total_amount")       // 含税总额 = subtotal + taxAmount
  
  sortOrder       Int      @default(0) @map("sort_order") // 排序
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  contract        Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  
  @@map("contract_line_items")
}

enum LineItemType {
  PRODUCT   // 产品 - 通常 13% 税率
  SERVICE   // 服务 - 通常 6% 或 0% 税率
}

// 12. ContractDocument: 合同附件
model ContractDocument {
  id            String   @id @default(uuid())
  contractId    String   @map("contract_id")
  filename      String
  filepath      String
  mimetype      String
  size          Int
  uploadedById  String   @map("uploaded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  uploadedBy    User?    @relation(fields: [uploadedById], references: [id])

  @@map("contract_documents")
}



// 4. Milestones: 里程碑 (项目执行+收款)
model Milestone {
  id         String   @id @default(uuid())
  contractId String   @map("contract_id")
  name       String
  amount     Decimal
  status     MilestoneStatus @default(Pending)
  dueDate    DateTime? @map("due_date")
  
  // 执行与回款记录
  acceptanceDate DateTime? @map("acceptance_date") // 验收日期
  acceptanceNote String?   @map("acceptance_note") // 验收说明
  invoiceDate    DateTime? @map("invoice_date")    // 开票日期
  paymentDate    DateTime? @map("payment_date")    // 回款日期
  
  createdAt  DateTime @default(now()) @map("created_at")

  contract Contract @relation(fields: [contractId], references: [id])
  invoice  Invoice?

  @@map("milestones")
}

enum MilestoneStatus {
  Pending
  WIP // Work In Progress
  Completed        // 已完成
  Verified         // 已验收
  Ready_to_Invoice // 待开票
  Invoiced         // 已开票
  Paid             // 已收款
}

// 5. FollowUp: 跟进记录
model FollowUp {
  id            String   @id @default(uuid())
  opportunityId String   @map("opportunity_id")
  content       String   // 富文本内容 (HTML)
  createdBy     String?  @map("created_by") // Legacy: Store name directly
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [createdById], references: [id])

  @@map("follow_ups")
}

// 6. Attachment: 附件
model Attachment {
  id            String   @id @default(uuid())
  opportunityId String   @map("opportunity_id")
  filename      String
  filepath      String   // 服务器存储路径
  mimetype      String
  size          Int
  createdAt     DateTime @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

// 7. Procurement: 投标记录
model Procurement {
  id                  String   @id @default(uuid())
  procurementNumber   String   @unique @map("procurement_number") // 投标编号 BID-YYYY-NNNN
  opportunityId       String   @map("opportunity_id")
  
  type                ProcurementType // 投标类型
  status              ProcurementStatus @default(Draft)
  
  // 团队分工
  commercialOwner     String?  @map("commercial_owner")   // 商务负责人
  technicalOwner      String?  @map("technical_owner")    // 技术负责人
  
  customerBudget      Decimal? @map("customer_budget")    // 客户预算
  ourQuote            Decimal? @map("our_quote")          // 我方报价
  submissionDeadline  DateTime? @map("submission_deadline") // 提交截止日期
  notificationDate    DateTime? @map("notification_date")   // 通知日期/开标日期
  bidLocation         String?  @map("bid_location")       // 开标地点
  depositAmount       Decimal? @map("deposit_amount")     // 投标保证金
  notes               String?                             // 备注
  resultNote          String?  @map("result_note")        // 结果说明
  wonPrice            Decimal? @map("won_price")          // 中标金额 (实际)
  
  // 投标费用
  tenderFee           Decimal? @map("tender_fee")         // 标书费
  agencyFee           Decimal? @map("agency_fee")         // 中标代理费
  printingFee         Decimal? @map("printing_fee")       // 打印费
  
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  opportunity         Opportunity @relation(fields: [opportunityId], references: [id])
  documents           ProcurementDocument[]
  tasks               BiddingTask[]
  lineItems           ProcurementLineItem[]

  @@map("procurements")
}

// 7a. ProcurementLineItem: 投标分项报价
model ProcurementLineItem {
  id            String   @id @default(uuid())
  procurementId String   @map("procurement_id")
  
  name          String
  type          String   // Product, Service, etc.
  amount        Decimal
  description   String?
  
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  
  procurement   Procurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  
  @@map("procurement_line_items")
}

// 8. BiddingTask: 投标材料任务
model BiddingTask {
  id            String   @id @default(uuid())
  procurementId String   @map("procurement_id")
  
  name          String                    // 任务名称：技术方案、商务报价等
  category      String   @default("other") // 分类: technical / commercial / qualification
  isCompleted   Boolean  @default(false)  @map("is_completed")
  assignee      String?                   // 负责人
  
  // 关联文件
  documentId    String?  @map("document_id")
  
  sortOrder     Int      @default(0)      @map("sort_order")
  createdAt     DateTime @default(now())  @map("created_at")
  
  procurement   Procurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  
  @@map("bidding_tasks")
}

enum ProcurementType {
  DirectQuote       // 单一来源/直接报价
  Negotiation       // 商务谈判
  Comparison        // 比选
  Consultation      // 磋商
  PublicTender      // 公开招标
}

enum ProcurementStatus {
  Draft             // 草稿
  Preparing         // 准备中
  Submitted         // 已提交
  InProgress        // 进行中 (评审中)
  Won               // 中标
  Lost              // 未中标
}

// 8. ProcurementDocument: 采购文档
model ProcurementDocument {
  id            String   @id @default(uuid())
  procurementId String   @map("procurement_id")
  docType       String   @map("doc_type")   // quote / technical / commercial / qualification / response
  filename      String
  filepath      String
  mimetype      String
  size          Int
  
  uploadedById  String?  @map("uploaded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  procurement   Procurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  uploadedBy    User?       @relation(fields: [uploadedById], references: [id])

  @@map("procurement_documents")
}

// 9. Users: 用户体系
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         UserRole @default(SALES)
  email        String?
  createdAt    DateTime @default(now()) @map("created_at")

  createdFollowUps FollowUp[]
  uploadedDocs     ProcurementDocument[]
  auditLogs        AuditLog[]
  draftedContracts Contract[] @relation("ContractDrafter")
  approvedContracts Contract[] @relation("ContractApprover")
  contractDocuments ContractDocument[]
  projectResources  ProjectResource[]

  @@map("users")
}

enum UserRole {
  ADMIN
  SALES
  PRE_SALES
  COMMERCIAL // 商务
  TECHNICAL  // 技术
  MANAGER    // 经理 (审批)
  DEVELOPER
  USER
}

// 10. AuditLog: 审计日志
model AuditLog {
  id        String   @id @default(uuid())
  tableName String   @map("table_name")
  recordId  String   @map("record_id")
  action    String   // CREATE, UPDATE, DELETE
  userId    String?  @map("user_id")
  details   String?  // JSON string: { "field": { "old": "val", "new": "val" } }
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum ContractStatus {
  Draft             // 草稿 (起草合同)
  CustomerReview    // 客户审核
  InternalReview    // 我方审核
  CustomerSeal      // 客户盖章
  InternalSeal      // 我方盖章 (签订结束前一步)
  Signed            // 签订结束
  Terminated        // 已终止
}

// 11. Project: 项目执行
model Project {
  id                 String   @id @default(uuid())
  contractId         String   @unique @map("contract_id")
  status             ProjectStatus @default(Initialization)
  
  budget             Decimal?  @default(0)
  targetProfitMargin Decimal?  @map("target_profit_margin") // 预期利润率
  
  // Costs for profit calculation
  laborCost          Decimal?  @default(0) @map("labor_cost")
  outsourceCost      Decimal?  @default(0) @map("outsource_cost")
  travelCost         Decimal?  @default(0) @map("travel_cost")
  emergencySupportCost Decimal? @default(0) @map("emergency_support_cost")
  thirdPartyEquipmentCost Decimal? @default(0) @map("third_party_equipment_cost")
  softwareCost       Decimal?  @default(0) @map("software_cost")
  otherWeight        Decimal?  @default(0) @map("other_weight")
  
  complexity         ProjectComplexity @default(Low)
  financialRemarks   String?   @map("financial_remarks")
  
  isDelayed          Boolean   @default(false) @map("is_delayed")
  
  // Invoicing tracking
  requiresInvoicing     Boolean   @default(true) @map("requires_invoicing")
  invoicingCompleted    Boolean   @default(false) @map("invoicing_completed")
  invoicingCompletedAt  DateTime? @map("invoicing_completed_at")
  
  startDate          DateTime? @map("start_date")
  endDate            DateTime? @map("endDate")
  description        String?
  
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  contract  Contract @relation(fields: [contractId], references: [id])
  resources ProjectResource[]
  meetings  ProjectMeeting[]
  risks     ProjectRisk[]
  invoices  Invoice[]
  fundTransactions FundTransaction[]

  @@map("projects")
}

enum ProjectComplexity {
  Low
  Medium
  High
}

enum ProjectStatus {
  Initialization  // 启动中
  Planning        // 规划中
  Execution       // 实施中
  Delivery        // 交付中
  Maintenance     // 运维中
  Closed          // 已结项
}

model ProjectResource {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  userId        String   @map("user_id")
  role          String   // PM, Architect, Developer, Tester, etc.
  allocationPct Int      @default(100) @map("allocation_pct") // 投入比例
  
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@map("project_resources")
}

model ProjectMeeting {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  title         String
  type          ProjectMeetingType @default(Weekly)
  planDate      DateTime @map("plan_date")
  actualDate    DateTime? @map("actual_date")
  minutes       String?  // Markdown/RichText minutes content
  
  // File attachments for minutes
  filepath      String?
  filename      String?
  mimetype      String?
  
  createdAt     DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_meetings")
}

enum ProjectMeetingType {
  Kickoff
  Weekly
  Monthly
  Technical
  Review
  Adhoc
}

model ProjectRisk {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  description   String
  impact        ProjectRiskImpact @default(Medium)
  status        ProjectRiskStatus @default(Open)
  mitigationPlan String? @map("mitigation_plan")
  
  createdAt     DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_risks")
}

enum ProjectRiskImpact {
  Low
  Medium
  High
  Critical
}

enum ProjectRiskStatus {
  Open
  InMitigation
  Closed
  Occurred
}
// Finance Models - Invoice, Payment, MilestoneTemplate

model Invoice {
  id                String   @id @default(uuid())
  invoiceNumber     String   @unique @map("invoice_number")  // RM-2024-00001
  contractId        String   @map("contract_id")
  projectId         String?  @map("project_id")
  milestoneId       String?  @unique @map("milestone_id")
  
  // Invoice Details
  invoiceDate       DateTime @map("invoice_date")
  dueDate           DateTime @map("due_date")
  amount            Float
  taxRate           Float    @map("tax_rate")  // 0.06 or 0.13
  taxAmount         Float    @map("tax_amount")
  totalAmount       Float    @map("total_amount")
  
  // Type and Status
  type              InvoiceType
  status            InvoiceStatus @default(Draft)
  
  // Currency (extensible)
  currency          String   @default("RMB")
  exchangeRate      Float?   @map("exchange_rate")
  
  // Description
  description       String?
  remarks           String?
  
  // Receipt Attachment
  filePath          String?  @map("file_path")
  fileName          String?  @map("file_name")
  
  // Relations
  contract          Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  project           Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone         Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  payments          Payment[]
  
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  @@map("invoices")
}

enum InvoiceType {
  Service   // 服务 6%
  Product   // 产品 13%
}

enum InvoiceStatus {
  Draft
  Issued
  PartiallyPaid
  Paid
  Overdue
  Cancelled
}

model Payment {
  id              String   @id @default(uuid())
  paymentNumber   String   @unique @map("payment_number")
  invoiceId       String   @map("invoice_id")
  
  // Payment Details
  paymentDate     DateTime @map("payment_date")
  amount          Float
  currency        String   @default("RMB")
  
  // Payment Method
  paymentMethod   PaymentMethod @map("payment_method")
  bankName        String?  @map("bank_name")
  transactionRef  String?  @map("transaction_ref")
  
  // Status
  status          PaymentStatus @default(Confirmed)
  remarks         String?
  
  // Receipt File Storage
  filePath        String?  @map("file_path")    // 电子回单文件路径
  fileName        String?  @map("file_name")    // 电子回单文件名
  
  // Relations
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  @@map("payments")
}

enum PaymentMethod {
  BankTransfer
  Check
  Cash
  Other
}

enum PaymentStatus {
  Confirmed
  Reconciled
}

model MilestoneTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  
  // Milestone configuration as JSON
  milestones  String   // JSON array of milestone definitions
  
  isActive    Boolean  @default(true) @map("is_active")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("milestone_templates")
}

// Fund Management System

enum FundTransactionType {
  ADVANCE       // 垫资
  PASS_THROUGH  // 纯过单(含费)
  SIMPLE_PASS   // 普通过单
  BOOST         // 做业绩
  EXPENSE_ONLY  // 纯处理费用
  WITHDRAWAL    // 提现
}

enum FundTransactionStatus {
  DRAFT
  ACTIVE
  COMPLETED
  AUDIT_PENDING
  ARCHIVED
}

model FundTransaction {
  id          String                @id @default(uuid())
  project     Project?              @relation(fields: [projectId], references: [id])
  projectId   String?
  type        FundTransactionType
  status      FundTransactionStatus @default(DRAFT)
  description String?
  transactionDate DateTime? @map("transaction_date") // 交易日期
  partyName       String?   @map("party_name")       // 交易方名称 (手动填写)
  
  // 核心财务摘要
  totalAmount      Decimal   @default(0) // 总交易额
  principalAmount  Decimal   @default(0) // 垫资本金 (仅垫资)
  expectedDuration Int?      // 预计占用天数 OR 月数
  
  // 费率配置 (Snapshot)
  costRuleType     String?   // 'MONTHLY', 'FIXED'
  costRate         Decimal?  // 资金成本率
  passThreshold    Decimal?  // 过单费率/保留利润率
  
  allocations CapitalAllocation[]
  collections RevenueCollection[]
  payouts     ExpensePayout[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
  @@map("fund_transactions")
}

model CapitalAllocation {
  id            String          @id @default(uuid())
  transaction   FundTransaction @relation(fields: [transactionId], references: [id])
  transactionId String
  
  vendorName    String          // 供应商名称 (暂存名称)
  amount        Decimal
  paymentDate   DateTime
  
  // 实际成本计算
  actualDuration Int?           // 实际占用天数
  interestCost   Decimal        @default(0) // 计算出的利息成本
  
  createdAt     DateTime        @default(now())
  
  @@map("capital_allocations")
}

model RevenueCollection {
  id            String          @id @default(uuid())
  transaction   FundTransaction @relation(fields: [transactionId], references: [id])
  transactionId String
  
  customerName  String
  amount        Decimal
  receivedDate  DateTime
  
  createdAt     DateTime        @default(now())
  
  @@map("revenue_collections")
}

model ExpensePayout {
  id            String          @id @default(uuid())
  transaction   FundTransaction @relation(fields: [transactionId], references: [id])
  transactionId String
  
  beneficiary   String          // 受益人
  baseAmount    Decimal         // 原始计算基数 (差额)
  
  // 计算规则
  payoutType     String         // 'PRODUCT_13', 'SERVICE_6', 'SERVICE_0'
  conversionRate Decimal        // 折算率 (0.8, 0.88 等)
  
  netAmount      Decimal        // 实际打款额
  status         String         // 'PENDING', 'PAID'
  
  createdAt     DateTime        @default(now())
  
  @@map("expense_payouts")
}

// 13. Vendors: 厂商管理
model Vendor {
  id           String   @id @default(uuid())
  name         String   @unique
  type         String?  // 厂商类型
  industry     String?  // 行业
  region       String?  // 区域
  brand        String?  // 品牌/产品名称
  
  // Parent-Child Relation
  parentId     String?   @map("parent_id")
  parent       Vendor?   @relation("VendorHierarchy", fields: [parentId], references: [id])
  children     Vendor[]  @relation("VendorHierarchy")

  contactName  String?  @map("contact_name")
  contactPhone String?  @map("contact_phone")
  description  String?
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  opportunities Opportunity[]
  customers     Customer[]

  @@map("vendors")
}

// 14. Payment Accounts: 收款账户配置
model PaymentAccount {
  id           String   @id @default(uuid())
  accountName  String   @map("account_name")   // 账户名称（公司全称）
  bankName     String   @map("bank_name")      // 开户银行
  accountNumber String  @map("account_number") // 账号
  isDefault    Boolean  @default(false) @map("is_default") // 是否默认
  isActive     Boolean  @default(true) @map("is_active")   // 是否启用
  description  String?                         // 备注说明
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("payment_accounts")
}
